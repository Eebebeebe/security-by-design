# Kopieren nach .env und Werte anpassen. .env ist per .gitignore ausgeschlossen.
NODE_ENV=production
PORT=3000

# Postgres (docker-compose setzt DATABASE_URL selbst aus diesen Werten zusammen)
POSTGRES_USER=pizza
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=pizza
DATABASE_URL=postgres://pizza:change-me-to-a-long-random-value@localhost:5432/pizza

# Admin-Zugang: Pflicht, min. 12 Zeichen. Die App startet ohne starkes Passwort NICHT (Fail Fast).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
LOG_LEVEL=info
# LOG_FILE=/var/log/pizza/app.log
SESSION_TTL_MINUTES=60
# Für lokale Entwicklung ohne HTTPS auf false setzen. In Produktion IMMER true (Default).
COOKIE_SECURE=true
HEARTBEAT_INTERVAL_MS=30000
